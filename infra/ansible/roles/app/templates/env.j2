APP_NAME=toshLab
APP_ENV=production
APP_KEY={{ vault_app_key }}
APP_DEBUG=false
APP_URL=https://{{ app_domain }}

APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ db_name }}
DB_USERNAME={{ db_user }}
DB_PASSWORD="{{ vault_db_password }}"

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

{% if vault_mail_username %}
MAIL_MAILER=smtp
MAIL_HOST={{ vault_mail_host }}
MAIL_PORT={{ vault_mail_port }}
MAIL_USERNAME="{{ vault_mail_username }}"
MAIL_PASSWORD="{{ vault_mail_password }}"
{% else %}
# 送信の設定が無いあいだはメールを送らず、問い合わせは管理画面で確認する
MAIL_MAILER=log
{% endif %}
MAIL_FROM_ADDRESS="{{ vault_mail_from_address }}"
MAIL_FROM_NAME="${APP_NAME}"

SITE_ADMIN_EMAIL="{{ vault_site_admin_email }}"
SITE_THREADS_URL=https://www.threads.net/@yuru_saka_se
SITE_GITHUB_URL=https://github.com/toshlab/tosh_lab

# ブログ記事のファイル（記事専用のクローン。roles/posts_sync）
BLOG_CONTENT_PATH={{ posts_content_dir }}/content/posts
