APP_NAME="在庫管理デモ"
APP_ENV=production
APP_KEY={{ vault_demo_app_key }}
APP_DEBUG=false
APP_URL=https://{{ demo_domain }}

APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ demo_db_name }}
DB_USERNAME={{ demo_db_user }}
DB_PASSWORD="{{ vault_demo_db_password }}"

SESSION_DRIVER=file
SESSION_COOKIE=inventory_demo_session
SESSION_SECURE_COOKIE=true
# toshlab.jp とクッキーを共有しない
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

DEMO_MODE=true
DEMO_PORTFOLIO_URL=https://toshlab.jp
